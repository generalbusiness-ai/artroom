+import { expect, test } from "vitest";
+import { writeFileSync } from "node:fs";
+import { canonicalize, isRefusal, type PreparedAct } from "./packages/client/src/index.ts";
+import { CODE_REVIEW_ACTS } from "./packages/policy/src/declared.ts";
+import { FakeRoom } from "./packages/client/test/support/fake-room.ts";
+import { caught, joinAs, startRoom } from "./packages/client/test/support/setup.ts";
+
+test("63 retained unanswered keys plus two concurrent calls reserve at most the one remaining slot", async () => {
+  const { room } = await startRoom();
+  try {
+    const wire: { key: string; literalBody: string; signed: unknown }[] = [];
+    const capture: typeof fetch = (input, init) => {
+      const url = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
+      if (init?.method === "POST" && new URL(url).pathname.endsWith("/acts")) {
+        const literalBody = String(init.body); const signed = JSON.parse(literalBody);
+        if (signed.envelope?.kind === "claim") wire.push({ key: signed.envelope.idempotencyKey, literalBody, signed });
+      }
+      return fetch(input, init);
+    };
+    const { api, signer } = await joinAs(room, "@alice", "member", { retries: 0, fetch: capture });
+    const sign = signer.sign.bind(signer); const claimSigningBytes: string[] = [];
+    (signer as { sign: typeof sign }).sign = async (bytes) => {
+      const text = new TextDecoder().decode(bytes); const split = text.indexOf("\n");
+      if (text.slice(0, split) === "artroom-envelope-v1" && JSON.parse(text.slice(split + 1)).kind === "claim") claimSigningBytes.push(text);
+      return sign(bytes);
+    };
+    const original = new Map<string, PreparedAct>(); const prepared: string[] = [];
+    const remember = (key: string) => (act: PreparedAct) => { prepared.push(key); if (!original.has(key)) original.set(key, structuredClone(act)); };
+    const seedLosses: unknown[] = [];
+    room.faults.push({ route: "POST /acts", kind: "drop", times: 63 });
+    for (let i = 0; i < 63; i++) seedLosses.push(await caught(api.claim({ goal: `held-${i}`, scope: [`src/held_${i}/**`] }, { idempotencyKey: `held-${i}`, onPrepared: remember(`held-${i}`) })));
+    const claims = () => room.entries.filter((e) => e.entry.type === "act" && e.entry.act.envelope.kind === "claim");
+    expect(claims()).toHaveLength(63); expect(seedLosses.every((e) => (e as { maybeRecorded?: boolean }).maybeRecorded === true)).toBe(true);
+    const before = { accepted: claims().length, signed: claimSigningBytes.length, prepared: prepared.length, posts: wire.length };
+    room.faults.push({ route: "POST /acts", kind: "drop", times: 2 });
+    let release!: () => void; const together = new Promise<void>((resolve) => { release = resolve; });
+    const pair = ["left", "right"].map((name) => together.then(() => api.claim({ goal: name, scope: [`src/${name}/**`] }, { idempotencyKey: `parallel-${name}`, onPrepared: remember(`parallel-${name}`) })));
+    release(); const results = await Promise.allSettled(pair);
+    const afterPair = { accepted: claims().length, signed: claimSigningBytes.length, prepared: prepared.length, posts: wire.length, results };
+    // Retained-byte controls: the old key and both concurrent keys return their originals after activation.
+    await room.activate({ ...CODE_REVIEW_ACTS });
+    const replays: unknown[] = [];
+    for (const key of ["held-0", "parallel-left", "parallel-right"]) {
+      if (!original.has(key)) continue;
+      const saved = original.get(key)!; const envelope = saved.signed!.envelope;
+      let repeated: PreparedAct | undefined; const postIndex = wire.length;
+      const result = await api.claim(envelope.body as never, { idempotencyKey: key, onPrepared: (act) => void (repeated = act) });
+      expect(isRefusal(result)).toBe(false);
+      const first = claims().find((e) => e.entry.type === "act" && e.entry.act.envelope.idempotencyKey === key)!;
+      expect((result as { id: string }).id).toBe(FakeRoom.idOf(first));
+      expect(canonicalize(repeated)).toBe(canonicalize(saved));
+      const originalWire = wire.find((x) => x.key === key)!; expect(wire[postIndex]!.literalBody).toBe(originalWire.literalBody);
+      replays.push({ key, result, saved, repeated, savedCanonical: canonicalize(saved), repeatedCanonical: canonicalize(repeated), originalWire: originalWire.literalBody, repeatedWire: wire[postIndex]!.literalBody });
+    }
+    expect(claims()).toHaveLength(afterPair.accepted); expect(claimSigningBytes).toHaveLength(afterPair.signed);
+    const observations = { head: "048c74113b19e56e5e3def0a9e0244209f6015dc", fidelity: "exact client against unchanged FakeRoom HTTPS seam; generated local Ed25519 signer instrumented without changing signatures; no real Room/provider", before, afterPair, deltas: { accepted: afterPair.accepted - before.accepted, signed: afterPair.signed - before.signed, prepared: afterPair.prepared - before.prepared, posts: afterPair.posts - before.posts }, seedLosses, replays, afterRetry: { accepted: claims().length, signed: claimSigningBytes.length, posts: wire.length }, claimSigningBytes, wire };
+    writeFileSync("/tmp/artroom-checker-stage5-048c-cwox6gjb/concurrent-observations.json", JSON.stringify(observations, null, 2) + "\n");
+    expect(afterPair.posts - before.posts, "both concurrent calls consumed the one remaining slot; the promised 64 bound was bypassed").toBeLessThanOrEqual(1);
+  } finally { await room.stop(); }
+});
