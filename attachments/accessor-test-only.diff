+/** Independent bounded c38 probe. FakeRoom is only the HTTP receiver; no real admission claim. */
+import { afterEach, beforeEach, describe, expect, test } from "vitest";
+import type { ActDeclaration, Claim, Json, Signer } from "@generalbusiness/artroom-contract";
+import { CODE_REVIEW_ACTS } from "@generalbusiness/artroom-policy/declared";
+import { connect, verifyValue, type HttpRoomClient, type PreparedAct } from "../src/index.ts";
+import { FakeRoom } from "./support/fake-room.ts";
+import { FAST, joinAs, startRoom, type Url } from "./support/setup.ts";
+
+let room: FakeRoom;
+let url: Url;
+beforeEach(async () => { ({ room, url } = await startRoom()); });
+afterEach(async () => { await room.stop(); });
+const ASK: ActDeclaration = { label: "Ask", targets: { entry: ["comment"] }, body: { text: { type: "text", max: 200 } }, who: { roles: ["member", "agent"] } };
+class Question { text = "class value"; }
+
+async function runCase(name: string, body: unknown, getterReads: () => number) {
+  const alice = await joinAs(room, "@alice");
+  await room.activate({ ...CODE_REVIEW_ACTS, ask: ASK });
+  const claim = await alice.api.claim({ goal: "control", scope: ["src/**"] }) as Claim;
+  const binding = (await room.bindingOf("ask"))!;
+  const signBytes: string[] = [];
+  const posts: string[] = [];
+  const signer: Signer = {
+    key: alice.signer.key,
+    async sign(bytes) {
+      signBytes.push(new TextDecoder().decode(bytes));
+      return alice.signer.sign(bytes);
+    },
+  };
+  const api = await connect({ url }, room.id, { kind: "key", signer }, {
+    ...FAST,
+    fetch(input, init) {
+      if (init?.method === "POST" && new URL(String(input)).pathname.endsWith("/acts")) posts.push(String(init.body));
+      return fetch(input, init);
+    },
+  }) as HttpRoomClient;
+  // Connecting can sign read requests; only the act call below is counted.
+  signBytes.length = 0;
+  posts.length = 0;
+  let hookCount = 0;
+  let prepared: PreparedAct | undefined;
+  let outcome: unknown;
+  let error: unknown;
+  try {
+    outcome = await api.act("ask", { act: claim.id }, body as Record<string, Json>, {
+      binding, idempotencyKey: `probe-${name}`,
+      onPrepared(p) { hookCount++; prepared = p; },
+    });
+  } catch (e) {
+    error = e;
+  }
+  const verifies = prepared?.signed === undefined ? null : await verifyValue("artroom-envelope-v1", prepared.signed.envelope, prepared.signed.sig, signer.key);
+  const observed = {
+    name, getterReads: getterReads(), hookCount, signCount: signBytes.length,
+    postCount: posts.length, error: error ?? null, outcome: outcome ?? null,
+    retainedBody: prepared?.body ?? null,
+    retainedSigned: prepared?.signed ?? null,
+    retainedVerifies: verifies, signBytes, posts,
+    retainedMatchesPost: prepared?.signed === undefined || posts.length === 0 ? null : JSON.stringify(prepared.signed) === posts[0],
+  };
+  console.log("CHECKER_OBSERVATION " + JSON.stringify(observed));
+  api[Symbol.dispose]();
+  return observed;
+}
+
+describe("c38 pre-copy plain-data boundary", () => {
+  test("control: direct class is refused before signature, prepared hook or act POST", async () => {
+    const observed = await runCase("direct-class", new Question(), () => 0);
+    expect(observed.error).toMatchObject({ name: "ArtroomError", code: "bad-request" });
+    expect([observed.signCount, observed.hookCount, observed.postCount]).toEqual([0, 0, 0]);
+  });
+  test("control: legal plain data is signed, prepared and sent unchanged", async () => {
+    const observed = await runCase("plain-data", { text: "plain value" }, () => 0);
+    expect(observed.error).toBeNull();
+    expect([observed.signCount, observed.hookCount, observed.postCount]).toEqual([1, 1, 1]);
+    expect(observed.retainedBody).toEqual({ text: "plain value" });
+    expect(observed.retainedVerifies).toBe(true);
+    expect(observed.retainedMatchesPost).toBe(true);
+  });
+  test("an enumerable getter returning a class during copying is refused before signature, prepared hook or act POST", async () => {
+    let reads = 0;
+    const body = Object.defineProperty({}, "text", {
+      enumerable: true,
+      get() { reads++; return reads === 1 ? "validated scalar" : new Question(); },
+    });
+    const observed = await runCase("changing-getter", body, () => reads);
+    expect(observed.error, "non-data accessors must be refused before copying").toMatchObject({ name: "ArtroomError", code: "bad-request" });
+    expect([observed.signCount, observed.hookCount, observed.postCount], "the class revealed during copying must not reach signing, the prepared hook or POST /acts").toEqual([0, 0, 0]);
+  });
+});
