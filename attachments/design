  }
  screenSelect.addEventListener('change',()=>setSpec(screenSelect.value));deviceSelect.addEventListener('change',()=>{state.device=deviceSelect.value;render();remember();});
  root.addEventListener('input',event=>{const el=event.target;if(el.matches('[data-search]')){state.query=el.value;state.listState[state.screen].query=state.query;const isIssue=state.screen==='issues',all=state.empty?[]:isIssue?issues:changes;const result=all.filter(row=>(state.filter==='all'||(isIssue?row.state===state.filter:state.filter==='merged'?row.state==='merged':row.state!=='merged'))&&`${row.title} ${row.id} ${row.author}`.toLowerCase().includes(state.query.toLowerCase()));app.querySelector('[data-list]').innerHTML=rows(result,isIssue,all.length===0);if(globalThis.lucide)lucide.createIcons({attrs:{width:18,height:18}});announce(result.length+' matches.');}
    const d=el.dataset.draft;if(d==='room')state.roomDraft=el.value;if(d==='comment'){state.commentDraft=el.value;const subject=state.screen==='issue'?currentIssue():currentChange();state.commentDrafts[commentKey(subject)]=el.value;app.querySelector('[data-action="save-comment"]').disabled=!el.value.trim();}if(d==='issue-title')state.issueDraft.title=el.value;if(d==='issue-body')state.issueDraft.body=el.value;if(d==='change-title')state.editDraft.title=el.value;if(d==='change-path')state.editDraft.path=el.value;if(d==='change-body')state.editDraft.body=el.value;if(el.tagName==='INPUT')el.setCustomValidity('');});
  root.addEventListener('change',event=>{const el=event.target;if(el.dataset.rule){state.ruleDraft[el.dataset.rule]=el.value;state.rulesDirty=Object.keys(state.rules).some(k=>state.rules[k]!==state.ruleDraft[k]);app.querySelector('[data-action="save-rules"]').disabled=!state.rulesDirty;}if(el.hasAttribute('data-appearance')){state.theme=el.value;app.style.colorScheme=state.theme==='system'?'light dark':state.theme;}});
  root.addEventListener('submit',event=>event.preventDefault());
  root.addEventListener('click',event=>{const el=event.target.closest('button');if(!el||!root.contains(el))return;if(el.dataset.filter){state.filter=el.dataset.filter;state.listState[state.screen].filter=state.filter;render();app.querySelector(`[data-filter="${state.filter}"]`).focus();return;}if(el.dataset.tab){state.tab=el.dataset.tab;render();app.querySelector(`[data-tab="${state.tab}"]`).focus();return;}const action=el.dataset.action;if(!action)return;if(action.startsWith('save-')&&action!=='save-rules'){save(action);return;}
    if(['issues','changes','pages','rules'].includes(action)){go(action);return;}if(action==='issue'){state.selectedIssue=Number(el.dataset.id);go('issue');return;}if(action==='change'){state.selectedChange=Number(el.dataset.id);state.tab='files';go('change');return;}if(action==='change-back'){go('change');return;}if(action==='clear'){state.filter='all';state.query='';state.listState[state.screen]={filter:'all',query:''};render();return;}if(action==='compose-issue'){go(action);return;}if(['compose-change','edit-page','fix-path'].includes(action)){openEditor(action,el);return;}
    if(action==='request-review'){currentChange().state='review-requested';render();announce('Review requested for this version.');return;}if(['rooms','account','create','view-request'].includes(action)){openModal(action,el);return;}if(action==='select-room'){switchRoom(el.dataset.room);go('issues');return;}if(action==='close-modal'||action==='current-room'){closeModal();return;}if(action==='record'){openModal('record',el);return;}if(action==='review-dialog'){openModal('review',el);return;}if(action==='save-rules'){openModal('rule-review',el);return;}if(action==='confirm-rules'){state.rules={...state.ruleDraft};rooms[state.room].rules={...state.rules};state.rulesDirty=false;state.modal=null;render();announce('Rules saved.');return;}if(action==='toggle-issue'){const i=currentIssue();i.state=i.state==='closed'?'open':'closed';render();announce(i.state==='closed'?'Issue closed.':'Issue reopened.');return;}
    if(action==='merge'){const c=currentChange();c.state='pending';render();announce('Merge requested.');return;}if(action==='check-status'){const c=currentChange();c.state='merged';rooms[state.room].pages[c.file]=[...c.lines];render();announce('Merge confirmed in this sample.');return;}if(action==='preview'){go('preview');return;}if(action==='published'){const c=currentChange();state.pagePath=c.file;state.pageLines=[...c.lines];state.pageVersion=c.version;go('page');return;}if(action==='page'){state.pagePath=el.dataset.path;state.pageLines=[...rooms[state.room].pages[state.pagePath]];state.pageVersion=null;go('page');return;}
  });
  root.addEventListener('keydown',event=>{if(state.modal){if(event.key==='Escape'){event.preventDefault();closeModal();return;}if(event.key==='Tab'){const focusable=[...app.querySelectorAll('.dialog button:not(:disabled),.dialog input,.dialog textarea,.dialog select')];const first=focusable[0],last=focusable.at(-1);if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}}}
    if(event.target.matches('[role="tab"]')&&['ArrowRight','ArrowLeft','Home','End'].includes(event.key)){event.preventDefault();const names=['discussion','files','checks'];const index=names.indexOf(state.tab);state.tab=event.key==='Home'?names[0]:event.key==='End'?names.at(-1):names[(index+(event.key==='ArrowRight'?1:2))%3];render();app.querySelector(`[data-tab="${state.tab}"]`).focus();}
    if(event.key==='Enter'&&event.target.tagName==='INPUT'&&!event.target.matches('[data-search]')){const form=event.target.closest('form');const submit=form?.querySelector('button.primary:not(:disabled)');if(submit){event.preventDefault();submit.click();}}
  });
  window.addEventListener('openai:set_globals',event=>{const next=event.detail?.globals?.widgetState?.privateContent;if(next?.revision!==2||next.origin===localOrigin)return;if(['responsive','390','320'].includes(next.device))state.device=next.device;if(viewNames.includes(next.view)&&next.view!==state.screen)setSpec(next.view,false);else render();});
  if(viewNames.includes(state.screen)&&!['issues','changes','rules'].includes(state.screen))setSpec(state.screen);else render();deviceSelect.value=state.device;
  if(globalThis.Tweak){const choice={density:'Comfortable'};const tweak=new Tweak({container:root,onChange:()=>{app.style.setProperty('--row-density',choice.density==='Compact'?'8px':'12px');}});tweak.addSelect(choice,'density',{label:'List spacing',options:['Comfortable','Compact']});}
})();
</script>
