// The Room Worker, deployable. It hosts the Room and Registry Durable
// Objects, and lane B's publisher sandbox (the `Publisher` Durable Object,
// a container with git only, and its `ArtifactsGateway`), exported from
// src/index.ts. The workerd test pool uses wrangler.test.jsonc instead.
//
// Before `wrangler deploy`:
// - the Artifacts namespace below must exist on the account, and
//   ARTIFACTS_HOST must be that account's Artifacts host;
// - the container image is lane B's (packages/git/container/image.sh copies
//   alpine/git into the account's registry); use the digest it prints;
// - secrets: `wrangler secret put ROOM_KEY_SECRET`;
// - OPERATOR_KEYS lists the operator key IDs that sign onboarding grants;
// - PUBLIC_URL is this deployment's https:// origin, and has no default:
//   `wrangler deploy --var PUBLIC_URL:https://<host>`. Redemption sends a
//   bearer token to that host, and the Worker refuses to start without it.
//
// To import repositories as well as found public rooms, add a second
// Artifacts binding for another namespace (an import's repository must be
// outside PUBLIC_NAMESPACE, R-GEN-12): an `artifacts` entry
// { "binding": "IMPORT_ARTIFACTS", "namespace": "<ns>", "remote": true } and
// the var "IMPORT_NAMESPACE": "<ns>". Without them, imports are refused at
// draft, with that reason.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artroom-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // The lease length in seconds (R-LANE-5).
    "LEASE_SECONDS": "1800",
    // The repository namespace reserved for public founding (R-GEN-12).
    "PUBLIC_NAMESPACE": "artroom-public",
    // The Artifacts namespace the ARTIFACTS binding reaches. Public founding creates repositories here.
    "ARTIFACTS_NAMESPACE": "artroom-public",
    // The sandbox's gateway lets the container reach only this host, under ARTIFACTS_NAMESPACE.
    "ARTIFACTS_HOST": "6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net",
    // Operator key IDs, comma-separated, whose onboarding grants are accepted (R-GEN-12).
    "OPERATOR_KEYS": ""
  },
  "secrets": { "required": ["ROOM_KEY_SECRET"] },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "artroom-public", "remote": true }],
  "containers": [
    {
      "class_name": "Publisher",
      "scheduling_policy": "durable_object",
      "images": {
        "git": {
          "image": "registry.cloudflare.com/6e953d231f1c9aadffbf59537a82e13a/artroom-lb-git@sha256:4a54f21b0d8e4a065ea83a7c51a707682036428f9ddd1362069dcd28d36c0c68"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "PUBLISHER", "class_name": "Publisher" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Registry"] },
    { "tag": "v2", "new_sqlite_classes": ["Publisher"] }
  ]
}
