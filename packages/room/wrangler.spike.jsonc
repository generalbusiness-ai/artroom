// The spike deployment of the Room Worker (request 25ecefb8). It is the same
// Worker as wrangler.jsonc, deployed as `artroom-spike-room` against the
// `gitseq-spike` Artifacts namespace, for live smoke runs. The production
// file, wrangler.jsonc, is unchanged.
//
// Deploy and redeploy with packages/room/scripts/deploy-spike.sh, which puts
// ROOM_KEY_SECRET with `wrangler secret put` (on stdin, never in the repo)
// and then deploys this file. See notes/deploy-spike.md.
//
// Public founding and the ARTIFACTS binding use the same namespace, as in
// production: a room founded with `{ "kind": "new" }` gets a fresh
// repository in gitseq-spike. A grant cannot name a repository in the public
// namespace (R-GEN-12), so imports use a second binding, IMPORT_ARTIFACTS,
// for gitseq-spike-import (request b6b51de7, revision 2, approved by hugh):
// one deployment both founds public rooms and imports.
//
// The checkers (request 9f81f372) are lane G's service, deployed as
// `artroom-spike-checkers` (packages/checkers/wrangler.spike.jsonc). The Room
// issues each check job over the service binding named for its checker,
// CHECKER_<NAME> (`checkerBinding` in src/config.ts). The two Workers bind
// each other; deploy-spike.sh deploys them in the order that allows it.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artroom-spike-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "LEASE_SECONDS": "1800",
    // The deployed workers.dev URL.
    "PUBLIC_URL": "https://artroom-spike-room.inguz.workers.dev",
    "PUBLIC_NAMESPACE": "gitseq-spike",
    "ARTIFACTS_NAMESPACE": "gitseq-spike",
    // The only namespace an onboarding grant may name; IMPORT_ARTIFACTS reaches it.
    "IMPORT_NAMESPACE": "gitseq-spike-import",
    "ARTIFACTS_HOST": "6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net",
    // The spike operator's key ID (its seed is in ~/.config/generalbusiness/artroom-spike.env).
    "OPERATOR_KEYS": "key_YPyqnnYvpoDxlDj_8mTlI4IHzyZ8002lmXgrV7NuylE"
  },
  "secrets": { "required": ["ROOM_KEY_SECRET"] },
  // Lane G's checker service, one entrypoint per checker (R-EXEC-8).
  "services": [
    { "binding": "CHECKER_TESTS", "service": "artroom-spike-checkers", "entrypoint": "TestsCheckerService" },
    { "binding": "CHECKER_TYPES", "service": "artroom-spike-checkers", "entrypoint": "TypesCheckerService" },
    { "binding": "CHECKER_LLM_REVIEW", "service": "artroom-spike-checkers", "entrypoint": "LlmReviewService" }
  ],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "gitseq-spike", "remote": true },
    { "binding": "IMPORT_ARTIFACTS", "namespace": "gitseq-spike-import", "remote": true }
  ],
  "containers": [
    {
      "class_name": "Publisher",
      "scheduling_policy": "durable_object",
      // Lane B's image: alpine/git copied into the account's registry by
      // packages/git/container/image.sh, pinned by digest.
      "images": {
        "git": {
          "image": "registry.cloudflare.com/6e953d231f1c9aadffbf59537a82e13a/artroom-lb-git@sha256:4a54f21b0d8e4a065ea83a7c51a707682036428f9ddd1362069dcd28d36c0c68"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "PUBLISHER", "class_name": "Publisher" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Registry"] },
    { "tag": "v2", "new_sqlite_classes": ["Publisher"] }
  ]
}
