{
  "name": "@generalbusiness/artroom-cli",
  "version": "0.1.0-dev.1",
  "description": "The artroom command for the new model: install, claim, invite, join, acts, act, log, show and verify, as thin functions over a scope service's HTTP routes and a signing key.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "bin": {
    "artroom": "./bin/artroom.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scope.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@generalbusiness/artroom-bytes": "0.1.0-dev.1",
    "@generalbusiness/artroom-client": "0.1.0-dev.1",
    "@generalbusiness/artroom-contract": "0.1.0-dev.1",
    "@generalbusiness/artroom-derive": "0.1.0-dev.1",
    "@generalbusiness/artroom-platform": "0.1.0-dev.1",
    "@generalbusiness/artroom-replay": "0.1.0-dev.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "@generalbusiness/artroom-scope": "0.1.0-dev.1",
    "@types/node": "26.6.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
