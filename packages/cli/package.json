{
  "name": "@generalbusiness/dap-cli",
  "version": "0.1.0-dev.1",
  "description": "The dap command: install, claim, invite, join, acts, act, log, show, verify, remote, clone, edit, merge, issue and issues, mcp, as thin functions over a scope service's HTTP routes and a signing key.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "bin": {
    "dap": "./bin/dap.js",
    "artroom": "./bin/dap.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scope.json",
    "test": "vitest run --config vitest.config.ts && node --test test/config-dir.test.mjs"
  },
  "dependencies": {
    "@generalbusiness/artroom-bytes": "0.1.0-dev.1",
    "@generalbusiness/artroom-client": "0.1.0-dev.1",
    "@generalbusiness/artroom-replay": "0.1.0-dev.1",
    "@generalbusiness/dap-contract": "0.1.0-dev.1",
    "@generalbusiness/dap-derive": "0.1.0-dev.1",
    "@generalbusiness/dap-mcp": "0.1.0-dev.1",
    "@generalbusiness/dap-platform": "0.1.0-dev.1",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "@generalbusiness/artroom-scope": "0.1.0-dev.1",
    "@types/node": "26.6.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generalbusiness-ai/dap.git",
    "directory": "packages/cli"
  },
  "homepage": "https://dap.generalbusiness.ai/"
}
