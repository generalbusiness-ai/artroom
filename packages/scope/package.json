{
  "name": "@generalbusiness/artroom-scope",
  "version": "0.1.0-dev.1",
  "description": "Artroom's scope runtime: storage, the commit protocol, delivery between scopes, the outbox dispatcher, reads and the Worker's routes, as Cloudflare Durable Objects with SQLite storage in one namespace.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./testing": "./src/testing.ts",
    "./testing/worker": "./test/worker.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@generalbusiness/artroom-bytes": "0.1.0-dev.1",
    "@generalbusiness/artroom-contract": "0.1.0-dev.1",
    "@generalbusiness/artroom-derive": "0.1.0-dev.1",
    "@generalbusiness/artroom-platform": "0.1.0-dev.1"
  },
  "devDependencies": {
    "@generalbusiness/artroom-client": "0.1.0-dev.1",
    "@generalbusiness/artroom-replay": "0.1.0-dev.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
