{
  "name": "@generalbusiness/artroom-scope",
  "version": "0.1.0-dev.1",
  "description": "Artroom's scope runtime for one scope: storage, the commit protocol, the outbox table and reads, as a Cloudflare Durable Object with SQLite storage.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
