{
  "name": "@generalbusiness/artroom-lanes",
  "version": "0.1.0-dev.1",
  "description": "Artroom's two lane definitions, issue and change, as data. No platform package depends on it.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./definitions/issue.json": "./definitions/issue.json",
    "./definitions/change.json": "./definitions/change.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "pin": "node scripts/pin.mjs"
  },
  "dependencies": {
    "@generalbusiness/artroom-contract": "0.1.0-dev.1"
  },
  "devDependencies": {
    "@generalbusiness/artroom-bytes": "0.1.0-dev.1",
    "@generalbusiness/artroom-derive": "0.1.0-dev.1",
    "@types/node": "26.6.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
