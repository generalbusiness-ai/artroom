{
  "name": "@generalbusiness/dap-mcp",
  "version": "0.1.0-dev.1",
  "description": "One MCP service for every dap application: generic tools, one act tool per act declaration the room holds, custody of signed envelopes, and the stdio and loopback HTTP transports for both MCP wire revisions.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scope.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@generalbusiness/artroom-bytes": "0.1.0-dev.1",
    "@generalbusiness/artroom-client": "0.1.0-dev.1",
    "@generalbusiness/dap-contract": "0.1.0-dev.1",
    "@generalbusiness/dap-platform": "0.1.0-dev.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "@generalbusiness/artroom-scope": "0.1.0-dev.1",
    "@generalbusiness/dap-derive": "0.1.0-dev.1",
    "@generalbusiness/dap-lanes": "0.1.0-dev.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.3",
    "gpt-tokenizer": "3.4.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generalbusiness-ai/dap.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://dap.generalbusiness.ai/"
}
