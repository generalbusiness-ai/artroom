{
  // The stories on real scopes run in the Workers runtime, as the scope package's tests do. They reach only what runs in any
  // runtime (`src/index.ts`), not `node.ts`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "resolveJsonModule": true,
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "node"],
    "skipLibCheck": true
  },
  "include": ["test/**/*.scope.test.ts", "test/support/*.ts", "../scope/test/env.d.ts"],
  // The custody fixtures run in Node, with the file store and child processes.
  "exclude": ["test/support/custody.ts", "test/support/custody-child.ts"]
}
