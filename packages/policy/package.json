{
  "name": "@generalbusiness/artroom-policy",
  "version": "0.0.0",
  "description": "Artroom's policy runtime: the artroom-jsonata-v1 evaluator, the five rule kinds, the platform carry decision and the policy authoring helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/helpers.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run test:node && npm run test:workerd",
    "test:node": "vitest run --config vitest.config.ts",
    "test:workerd": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@generalbusiness/artroom-contract": "0.0.0",
    "jsonata": "2.2.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "vitest": "4.1.11"
  }
}
