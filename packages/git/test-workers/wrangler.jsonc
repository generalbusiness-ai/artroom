{
	// Test Worker for the workerd tests (vitest-pool-workers). Not deployed.
	"name": "artroom-lb-git-test",
	"main": "./worker.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"vars": { "ARTIFACTS_HOST": "acct.artifacts.cloudflare.net", "ARTIFACTS_NAMESPACE": "ns" },
	"durable_objects": {
		"bindings": [
			{ "class_name": "TestRoom", "name": "ROOM" },
			{ "class_name": "FakeRemote", "name": "REMOTE" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestRoom", "FakeRemote"] }]
}
