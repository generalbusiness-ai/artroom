{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Lane B's Worker: the publisher sandbox (a container with git only) and a
	// key-protected harness Room for live tests. The Room of lane A hosts the
	// same classes from this package.
	"name": "artroom-lb-git",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"observability": { "enabled": true },
	"vars": {
		// Only remotes on this host, under this namespace, are accepted.
		"ARTIFACTS_HOST": "6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net",
		"ARTIFACTS_NAMESPACE": "gitseq-spike"
	},
	"secrets": { "required": ["LB_KEY"] },
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitseq-spike", "remote": true }],
	"containers": [
		{
			"class_name": "Publisher",
			"scheduling_policy": "durable_object",
			// alpine/git (linux/amd64) copied into Cloudflare's registry with crane;
			// see container/image.sh. With Docker, use container/Dockerfile instead.
			"images": {
				"git": {
					"image": "registry.cloudflare.com/6e953d231f1c9aadffbf59537a82e13a/artroom-lb-git@sha256:4a54f21b0d8e4a065ea83a7c51a707682036428f9ddd1362069dcd28d36c0c68"
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{ "class_name": "Publisher", "name": "PUBLISHER" },
			{ "class_name": "HarnessRoom", "name": "HARNESS" }
		]
	},
	"exports": {
		"Publisher": { "type": "durable-object", "storage": "sqlite" },
		"HarnessRoom": { "type": "durable-object", "storage": "sqlite" }
	}
}
