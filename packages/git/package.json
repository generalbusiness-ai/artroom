{
  "name": "@generalbusiness/artroom-git",
  "version": "0.1.0-dev.1",
  "description": "Artroom's one place that touches a Git repository or a Git host: the object reader, the commands, the evidence of a push, and the gateway that holds a token. It runs in Node and in a container, never in a scope's commit.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./http": "./src/http.ts",
    "./github": "./src/github.ts",
    "./http-read": "./src/http-read.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@generalbusiness/artroom-bytes": "0.1.0-dev.1",
    "@generalbusiness/artroom-contract": "0.1.0-dev.1",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
