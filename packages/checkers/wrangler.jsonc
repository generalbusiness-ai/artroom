{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// The checker service, for production: three checkers (tests, types, an
	// advisory LLM reviewer) as RPC entrypoints, and their runner sandboxes.
	// Jobs arrive only over a service binding from the Room Worker, which binds
	// each checker as CHECKER_<NAME> with this Worker's entrypoint:
	//   { "binding": "CHECKER_TESTS", "service": "artroom-checkers", "entrypoint": "TestsCheckerService" }
	//   { "binding": "CHECKER_TYPES", "service": "artroom-checkers", "entrypoint": "TypesCheckerService" }
	//   { "binding": "CHECKER_LLM_REVIEW", "service": "artroom-checkers", "entrypoint": "LlmReviewService" }
	// This Worker has no HTTPS routes (R-EXEC-8), and no room or delegation is
	// configured: each job names its room, which the service resolves through
	// ROOM. The live-run harness is measure/harness/, never deployed here.
	//
	// Before `wrangler deploy`:
	// - the Room Worker (ROOM's service) must be deployed;
	// - the runner image is lane G's (container/image.sh); use the digest it prints;
	// - ARTIFACTS_HOST and ARTIFACTS_NAMESPACES are the host and the namespaces
	//   the Room's jobs read from (its own, and its import namespace if any); an
	//   empty or malformed list stops every entrypoint;
	// - secret: `wrangler secret put CHECKER_KEY` (Ed25519 private JWK). Its key
	//   must be a member's key in each room whose checks it signs.
	"name": "artroom-checkers",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"observability": { "enabled": true },
	"vars": {
		"ARTIFACTS_HOST": "6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net",
		// The Artifacts namespaces jobs may read from, comma-separated: the Room's own and its import
		// namespace if any. A deployment whose Room uses other namespaces sets its own list.
		"ARTIFACTS_NAMESPACES": "artroom-public",
		"RUNNER_IMAGE": "registry.cloudflare.com/6e953d231f1c9aadffbf59537a82e13a/artroom-lg-runner@sha256:17b7fd60fd812617654c64b95f9b2dde94f103313073b672bc40fdad6dccbaa2",
		// The model the LLM reviewer uses. Any Workers AI text-generation model.
		"LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
	},
	"secrets": { "required": ["CHECKER_KEY"] },
	"ai": { "binding": "AI" },
	// The Room Worker's ArtroomService (its default entrypoint). Required.
	"services": [{ "binding": "ROOM", "service": "artroom-room" }],
	"containers": [
		{
			"class_name": "RunnerBox",
			"scheduling_policy": "durable_object",
			"images": { "runner": { "image": "registry.cloudflare.com/6e953d231f1c9aadffbf59537a82e13a/artroom-lg-runner@sha256:17b7fd60fd812617654c64b95f9b2dde94f103313073b672bc40fdad6dccbaa2" } }
		}
	],
	"durable_objects": { "bindings": [{ "class_name": "RunnerBox", "name": "RUNNER" }] },
	"exports": { "RunnerBox": { "type": "durable-object", "storage": "sqlite" } }
}
