    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@generalbusiness/artroom-bytes": "0.1.0-dev.1",
    "@generalbusiness/artroom-contract": "0.1.0-dev.1",
    "jsonata": "2.2.2"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
