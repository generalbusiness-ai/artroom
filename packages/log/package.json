{
  "name": "@generalbusiness/artroom-log",
  "version": "0.0.0",
  "description": "Artroom's log publication and offline verification: signed log commits on refs/artroom/log, and artroom verify.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./git-cli": "./src/gitcli.ts"
  },
  "bin": {
    "artroom-verify": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run test:node && npm run test:workerd",
    "test:node": "vitest run --config vitest.config.ts",
    "test:workerd": "vitest run --config vitest.workers.config.ts",
    "verify": "node src/cli.ts verify"
  },
  "dependencies": {
    "@generalbusiness/artroom-contract": "0.0.0",
    "@generalbusiness/artroom-policy": "0.0.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.6.3",
    "vitest": "4.1.11"
  }
}
