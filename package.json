{
  "name": "artroom",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run && node --test scripts/active-source.test.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
