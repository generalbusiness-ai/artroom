{
  "name": "artroom",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm test --workspace @generalbusiness/artroom-git --workspace @generalbusiness/artroom-ui && node --test scripts/release-manifest.test.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "gate": "bash scripts/gate.sh",
    "release:pack": "node scripts/pack-release.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
