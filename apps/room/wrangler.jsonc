// The scope Worker as it would be deployed: one Durable Object namespace, in
// which a scope's object is named by its scope ID and by nothing else, and
// the SQLite migration of its class. This file is configuration only.
// Run npm run deploy:scope from the repository root to deploy it.
//
// Read sessions need two more bindings, and neither is in this file. An
// operator sets them: the secret SESSION_SECRET, of at least 32 bytes from a
// cryptographic random source, from a file or standard input and never as an
// argument; and the variable DEPLOYMENT, the deployment's name. With either
// missing the Worker issues no session and accepts none, and no reader may
// read.
//
// Git hosts. A register names its host at install (`host`, `namespace`), and
// the Worker routes each host operation by that recorded host. With no host
// configured, every outside effect stays recorded and unsent.
//
// - Cloudflare Artifacts, for a register installed with
//   `--host artifacts --namespace artroom-demo`: the `artifacts` binding
//   below, and the variable ARTIFACTS_CONFIG, nonsecret JSON with exactly
//   the fields registerScope (the install's register scope ID), namespace
//   ("artroom-demo"), host (the service's hostname in its remote URLs),
//   maxBytes and credentialIdentity ("adapter-attempt"). No outside
//   credential is needed. docs/hosts.md says more.
// - GitHub, for a register installed with `--host github.com`: the
//   variable GITHUB_APP_CONFIG and the secrets GITHUB_APP_PRIVATE_KEY,
//   GITHUB_CREATION_TOKEN and GITHUB_READ_TOKEN (see
//   ../../packages/scope/src/github-wiring.ts).
//
// Set ARTIFACTS_NAMESPACE to the namespace of the ARTIFACTS binding when
// using a namespace other than artroom-demo. docs/self-host.md gives the steps.
// An operator sets the variables and secrets; this file holds no secret.
{
  "name": "artroom-scope",
  "main": "worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Source preparation only; deployment remains separately authorized.
  // Retain allowlisted console diagnoses without platform URL invocation logs.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "artroom_metrics_v1" }],
  "version_metadata": { "binding": "VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "SCOPES", "class_name": "DeployedScope" },
      // The hosted MCP endpoint: one registry per repository, one object per agent (docs/mcp.md, "The hosted endpoint").
      { "name": "REGISTRIES", "class_name": "McpRegistry" },
      { "name": "AGENTS", "class_name": "McpAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeployedScope"] },
    { "tag": "v2", "new_sqlite_classes": ["McpRegistry", "McpAgent"] }
  ],
  // Artifacts: one namespace, reached by the binding
  // ARTIFACTS. It takes effect only with ARTIFACTS_CONFIG set as above.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "artroom-demo", "remote": true }]
}
