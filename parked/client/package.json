{
  "name": "@generalbusiness/artroom-client",
  "version": "0.1.0-dev.1",
  "description": "Artroom's typed client: the contract's RoomApi over HTTPS (and RPC), with Ed25519 envelope signing, idempotent retries, invitation redemption and resumable cursors. WebCrypto only.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run test:node && npm run test:workerd",
    "test:node": "vitest run --config vitest.config.ts",
    "test:workerd": "vitest run --config vitest.workers.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@generalbusiness/artroom-contract": "0.1.0-dev.1",
    "@generalbusiness/artroom-policy": "0.1.0-dev.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.2",
    "vitest": "4.1.11",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ]
}
