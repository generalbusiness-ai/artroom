// The Room Worker as the workerd test pool runs it (vitest.workers.config.ts):
// the Room and Registry Durable Objects only. Tests give the Room fake
// Artifacts and sandbox remotes (src/memory/artifacts.ts), so this file has
// no Artifacts binding and no container. Deploy with wrangler.jsonc.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artroom-room-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Registry"] }],
  "vars": {
    "LEASE_SECONDS": "1800",
    "PUBLIC_URL": "https://artroom.test",
    "PUBLIC_NAMESPACE": "artroom-public",
    "IMPORT_NAMESPACE": "acme-import",
    // Stand-ins for the ARTIFACTS and IMPORT_ARTIFACTS bindings, which the test pool cannot have: founding
    // refuses a mode whose binding is absent, and the test services factory supplies the fake remotes.
    "ARTIFACTS": "test-stand-in",
    "IMPORT_ARTIFACTS": "test-stand-in",
    "OPERATOR_KEYS": ""
  }
}
