{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "artroom-spike-room-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomSpike" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomSpike"] }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitseq-spike", "remote": true }],
  "vars": { "REPO": "artroom-spike-tree" }
}
