{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "artroom-spike-sandbox-git",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },
	"vars": {
		// Only remotes on this host, under this namespace, are accepted.
		"ARTIFACTS_HOST": "6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net",
		"ARTIFACTS_NAMESPACE": "gitseq-spike"
	},
	"secrets": { "required": ["SPIKE_KEY"] },
	"containers": [
		{
			"class_name": "GitBox",
			"scheduling_policy": "durable_object",
			// No Docker daemon on the build machine, so the image is a copy of
			// alpine/git (linux/amd64) pushed with crane. See image.sh.
			// With Docker, use { "dockerfile": "./Dockerfile" } instead.
			"images": {
				"git": {
					"image": "registry.cloudflare.com/6e953d231f1c9aadffbf59537a82e13a/artroom-spike-git@sha256:4a54f21b0d8e4a065ea83a7c51a707682036428f9ddd1362069dcd28d36c0c68"
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [{ "class_name": "GitBox", "name": "GITBOX" }]
	},
	"exports": {
		"GitBox": { "type": "durable-object", "storage": "sqlite" }
	}
}
