// Request 5a7290b9's live harness: the real Room Worker plus a key-protected
// /lb/ route (worker.ts), on the gitseq-spike Artifacts namespace. Deploy,
// run and delete with run.mjs; never deploy it under any other name.
{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "artroom-lb-logbig",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Leases outlast the run, so no lease-expired entries interleave.
    "LEASE_SECONDS": "86400",
    "PUBLIC_URL": "https://artroom-lb-logbig.invalid",
    "PUBLIC_NAMESPACE": "gitseq-spike",
    "ARTIFACTS_NAMESPACE": "gitseq-spike",
    "ARTIFACTS_HOST": "6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net",
    "OPERATOR_KEYS": ""
  },
  "secrets": { "required": ["ROOM_KEY_SECRET", "LB_KEY"] },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitseq-spike", "remote": true }],
  "containers": [
    {
      "class_name": "Publisher",
      "scheduling_policy": "durable_object",
      "images": {
        "git": {
          "image": "registry.cloudflare.com/6e953d231f1c9aadffbf59537a82e13a/artroom-lb-git@sha256:4a54f21b0d8e4a065ea83a7c51a707682036428f9ddd1362069dcd28d36c0c68"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "PUBLISHER", "class_name": "Publisher" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Registry", "Publisher"] }]
}
